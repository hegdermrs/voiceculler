{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Voice Photo Culler",
  "version": "0.1.0",
  "identifier": "com.voiceculler.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run bundle-exiftool && npm run dev",
    "beforeBuildCommand": "npm run bundle-exiftool && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Photo Culler",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": {
      "resources/exiftool/": "exiftool/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
