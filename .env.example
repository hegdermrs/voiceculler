# Copy this file to ".env" and fill in your credential.

# Google OAuth 2.0 Client ID (Web application).
# Create at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins".
# Enable the Google Drive API for the project.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Voice needs no API key: it uses the open-source TensorFlow.js Speech Commands
# model, which runs entirely on-device in the browser.
